{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/example-git/crux/main/image-provider-plugin.schema.json",
  "$ref": "#/$defs/ImageManifest",
  "$defs": {
    "Compatibility": {
      "properties": {
        "host_api": {
          "$ref": "#/$defs/VersionBounds"
        },
        "host_version": {
          "$ref": "#/$defs/SemverBounds"
        },
        "required_features": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true
        },
        "optional_features": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "host_api"
      ]
    },
    "Configuration": {
      "properties": {
        "schema": {
          "type": "object",
          "description": "Draft 2020-12 JSON Schema for provider configuration"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/FieldDisplay"
          },
          "type": "object",
          "description": "Generic presentation hints keyed by configuration property"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schema"
      ]
    },
    "FieldDisplay": {
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "secret": {
          "type": "boolean"
        },
        "advanced": {
          "type": "boolean"
        },
        "order": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "label"
      ]
    },
    "ImageCredential": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "enum": [
            "environment",
            "provider",
            "browser"
          ]
        },
        "environment": {
          "type": "string",
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "maxLength": 64
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "source"
      ]
    },
    "ImageDimensionLimits": {
      "properties": {
        "multiple": {
          "type": "integer",
          "maximum": 16384,
          "minimum": 1
        },
        "max_edge": {
          "type": "integer",
          "maximum": 16384,
          "minimum": 1
        },
        "min_pixels": {
          "type": "integer",
          "maximum": 268435456,
          "minimum": 1
        },
        "max_pixels": {
          "type": "integer",
          "maximum": 268435456,
          "minimum": 1
        },
        "max_aspect": {
          "type": "integer",
          "maximum": 16384,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "multiple",
        "max_edge",
        "min_pixels",
        "max_pixels",
        "max_aspect"
      ]
    },
    "ImageFallback": {
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 128
        },
        "when_unavailable": {
          "type": "boolean"
        },
        "when_all_generation_requests_fail": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "model"
      ]
    },
    "ImageLimits": {
      "properties": {
        "requests": {
          "type": "integer",
          "maximum": 4096,
          "minimum": 1,
          "default": 512
        },
        "steps": {
          "type": "integer",
          "maximum": 65536,
          "minimum": 1,
          "default": 4096
        },
        "total_response_bytes": {
          "type": "integer",
          "maximum": 1073741824,
          "minimum": 1,
          "default": 1073741824
        },
        "concurrency": {
          "type": "integer",
          "maximum": 4,
          "minimum": 1
        },
        "variants": {
          "type": "integer",
          "maximum": 10,
          "minimum": 1
        },
        "input_images": {
          "type": "integer",
          "maximum": 16,
          "minimum": 0
        },
        "input_bytes": {
          "type": "integer",
          "maximum": 52428800,
          "minimum": 1
        },
        "total_input_bytes": {
          "type": "integer",
          "maximum": 209715200,
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "maximum": 104857600,
          "minimum": 1
        },
        "response_bytes": {
          "type": "integer",
          "maximum": 536870912,
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "maximum": 600,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "concurrency",
        "variants",
        "input_images",
        "input_bytes",
        "total_input_bytes",
        "output_bytes",
        "response_bytes",
        "timeout_seconds"
      ]
    },
    "ImageManifest": {
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "plugin_type": {
          "type": "string",
          "enum": [
            "image-provider"
          ]
        },
        "manifest_version": {
          "type": "integer",
          "maximum": 1,
          "minimum": 1
        },
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "publisher": {
          "$ref": "#/$defs/Publisher"
        },
        "compatibility": {
          "$ref": "#/$defs/Compatibility"
        },
        "backend": {
          "type": "string",
          "maxLength": 64
        },
        "configuration": {
          "$ref": "#/$defs/Configuration"
        },
        "credentials": {
          "items": {
            "$ref": "#/$defs/ImageCredential"
          },
          "type": "array",
          "maxItems": 16
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/ImageOrigin"
          },
          "type": "array",
          "maxItems": 32,
          "minItems": 1
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ImageModel"
          },
          "type": "array",
          "maxItems": 128,
          "minItems": 1
        },
        "client_identities": {
          "additionalProperties": {
            "$ref": "#/$defs/ResolvedClientIdentity"
          },
          "type": "object"
        },
        "default_model": {
          "type": "string",
          "maxLength": 128
        },
        "options": {
          "$ref": "#/$defs/ImageOptions"
        },
        "limits": {
          "$ref": "#/$defs/ImageLimits"
        },
        "session": {
          "type": "string",
          "maxLength": 64
        },
        "discovery": {
          "type": "string",
          "maxLength": 64
        },
        "upload": {
          "$ref": "#/$defs/ImageUpload"
        },
        "generate": {
          "type": "string",
          "maxLength": 64
        },
        "edit": {
          "type": "string",
          "maxLength": 64
        },
        "variant_mode": {
          "type": "string",
          "enum": [
            "individual",
            "batch"
          ]
        },
        "workflows": {
          "additionalProperties": {
            "$ref": "#/$defs/ImageWorkflow"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "plugin_type",
        "manifest_version",
        "id",
        "version",
        "name",
        "description",
        "publisher",
        "compatibility",
        "backend",
        "configuration",
        "origins",
        "models",
        "default_model",
        "options",
        "limits",
        "generate",
        "variant_mode",
        "workflows"
      ]
    },
    "ImageModel": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "availability_key": {
          "type": "string",
          "maxLength": 128
        },
        "parameters": {
          "type": "object"
        },
        "fallback": {
          "$ref": "#/$defs/ImageFallback"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "ImageOptions": {
      "properties": {
        "aspect_ratios": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true
        },
        "dimension_limits": {
          "$ref": "#/$defs/ImageDimensionLimits"
        },
        "quality": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        },
        "background": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        },
        "sizes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true
        },
        "dimensions": {
          "type": "boolean"
        },
        "output_extension": {
          "type": "string",
          "enum": [
            ".png",
            ".jpg",
            ".webp"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "quality",
        "background",
        "output_extension"
      ]
    },
    "ImageOrigin": {
      "properties": {
        "provider_credential": {
          "type": "string",
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "subdomains": {
          "type": "boolean"
        },
        "credentials": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "url"
      ]
    },
    "ImageRequest": {
      "properties": {
        "accepted_media_types": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT"
          ]
        },
        "url": {
          "$ref": "#/$defs/ImageValue"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/ImageValue"
          },
          "type": "object"
        },
        "query": {
          "additionalProperties": {
            "$ref": "#/$defs/ImageValue"
          },
          "type": "object"
        },
        "body": {
          "$ref": "#/$defs/ImageValue"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "none",
            "json",
            "form",
            "multipart",
            "binary"
          ]
        },
        "response": {
          "type": "string",
          "enum": [
            "json",
            "text",
            "binary",
            "framed-json"
          ]
        },
        "frame_prefix": {
          "type": "string",
          "maxLength": 128
        },
        "phase": {
          "type": "string",
          "enum": [
            "setup",
            "upload",
            "generation",
            "media",
            "download"
          ]
        },
        "max_bytes": {
          "type": "integer",
          "maximum": 536870912,
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "maximum": 600,
          "minimum": 1
        },
        "retry": {
          "$ref": "#/$defs/ImageRetry"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "url",
        "encoding",
        "response",
        "phase",
        "max_bytes",
        "timeout_seconds"
      ]
    },
    "ImageRetry": {
      "properties": {
        "attempts": {
          "type": "integer",
          "maximum": 10,
          "minimum": 1
        },
        "delay_ms": {
          "type": "integer",
          "maximum": 60000,
          "minimum": 0
        },
        "statuses": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "attempts",
        "delay_ms",
        "statuses"
      ]
    },
    "ImageStep": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "request": {
          "$ref": "#/$defs/ImageRequest"
        },
        "value": {
          "$ref": "#/$defs/ImageValue"
        },
        "assert": {
          "$ref": "#/$defs/ImageValue"
        },
        "call": {
          "type": "string",
          "maxLength": 64
        },
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/ImageValue"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id"
      ]
    },
    "ImageUpload": {
      "properties": {
        "workflow": {
          "type": "string",
          "maxLength": 64
        },
        "lookup": {
          "type": "string",
          "maxLength": 64
        },
        "cache_key": {
          "$ref": "#/$defs/ImageValue"
        },
        "persistent": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "workflow"
      ]
    },
    "ImageValue": {
      "properties": {
        "literal": true,
        "ref": {
          "type": "string",
          "maxLength": 1024
        },
        "op": {
          "type": "string",
          "maxLength": 64
        },
        "args": {
          "items": {
            "$ref": "#/$defs/ImageValue"
          },
          "type": "array",
          "maxItems": 64
        },
        "object": {
          "additionalProperties": {
            "$ref": "#/$defs/ImageValue"
          },
          "type": "object"
        },
        "array": {
          "items": {
            "$ref": "#/$defs/ImageValue"
          },
          "type": "array",
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ImageWorkflow": {
      "properties": {
        "steps": {
          "items": {
            "$ref": "#/$defs/ImageStep"
          },
          "type": "array",
          "maxItems": 64,
          "minItems": 1
        },
        "result": {
          "$ref": "#/$defs/ImageValue"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "steps",
        "result"
      ]
    },
    "Publisher": {
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        },
        "support_url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "ResolvedClientIdentity": {
      "properties": {
        "environment": {
          "type": "string",
          "maxLength": 128
        },
        "latest_url": {
          "type": "string",
          "maxLength": 2048
        },
        "version_pointer": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^/"
        },
        "cache_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "fallback_version": {
          "type": "string",
          "maxLength": 64
        },
        "version_pattern": {
          "type": "string",
          "maxLength": 256
        },
        "user_agent_format": {
          "type": "string",
          "maxLength": 256
        },
        "probe_timeout_ms": {
          "type": "integer",
          "maximum": 30000,
          "minimum": 1
        },
        "probe_max_bytes": {
          "type": "integer",
          "maximum": 65536,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "cache_key",
        "fallback_version",
        "version_pattern",
        "user_agent_format",
        "probe_timeout_ms",
        "probe_max_bytes"
      ]
    },
    "SemverBounds": {
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "VersionBounds": {
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "min",
        "max"
      ]
    }
  },
  "title": "Crux Image Provider Plugin Manifest"
}
