{
  "name": "crux-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --conditions=browser --test src/*.test.ts electron/*.test.mjs tests/ui.test.mjs",
    "test:integration": "node --conditions=browser --test tests/integration.test.ts",
    "desktop": "electron .",
    "desktop:prepare": "npm run build && cd .. && bash build.sh --build --embedded-mitmproxy",
    "desktop:pack": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --dir --publish never",
    "desktop:dist": "npm run desktop:prepare && electron-builder --config electron-builder.cjs --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "solid-js": "1.9.18"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  }
}
