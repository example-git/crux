{
  "$schema": "../../../../provider-plugin.schema.json",
  "manifest_version": 1,
  "id": "example.echo",
  "version": "1.0.0",
  "name": "Example Echo",
  "description": "Synthetic declarative provider used to demonstrate the minimum manifest contract.",
  "publisher": {
    "id": "example.docs",
    "name": "Example Documentation"
  },
  "compatibility": {
    "host_api": {
      "min": 1,
      "max": 1
    }
  },
  "provider": {
    "id": "example-echo",
    "name": "Example Echo",
    "account_namespace": "example.echo",
    "default_large_model": "echo-1",
    "default_small_model": "echo-1",
    "login_order": 1000,
    "account_order": 1000
  },
  "models": [
    {
      "id": "echo-1",
      "name": "Echo 1",
      "context_window": 8192,
      "default_max_tokens": 1024,
      "modalities": {
        "input": ["text"],
        "output": ["text"]
      }
    }
  ],
  "capabilities": {
    "endpoints": [
      {
        "id": "api",
        "base_url": "https://api.example.invalid",
        "allowed_schemes": ["https"],
        "allowed_hosts": ["api.example.invalid"],
        "override": "forbidden"
      }
    ],
    "operations": [
      {
        "id": "generate",
        "kind": "inference",
        "protocol": "generic-json",
        "transport": "http-json",
        "endpoint": "api",
        "method": "POST",
        "path": "/v1/generate"
      }
    ]
  },
  "configuration": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
}
