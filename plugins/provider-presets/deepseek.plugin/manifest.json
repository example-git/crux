{
  "$schema": "../../../provider-preset-plugin.schema.json",
  "plugin_type": "provider-preset",
  "manifest_version": 1,
  "id": "crux.catwalk.deepseek",
  "version": "0.51.23",
  "name": "DeepSeek Provider Preset",
  "description": "Optional DeepSeek provider and model catalog preset derived from Catwalk v0.51.23 for Crux's Foundation-owned OpenAI-compatible runtime.",
  "publisher": {
    "id": "crux.project",
    "name": "Crux Project",
    "url": "https://github.com/example-git/crux"
  },
  "compatibility": {
    "host_api": {
      "min": 1,
      "max": 1
    }
  },
  "preset": {
    "name": "DeepSeek",
    "id": "deepseek",
    "type": "openai-compat",
    "api_key": "$DEEPSEEK_API_KEY",
    "api_endpoint": "https://api.deepseek.com/v1",
    "default_large_model_id": "deepseek-v4-pro",
    "default_small_model_id": "deepseek-v4-flash",
    "models": [
      {
        "id": "deepseek-v4-flash",
        "name": "DeepSeek-V4-Flash",
        "cost_per_1m_in": 0.14,
        "cost_per_1m_out": 0.28,
        "cost_per_1m_in_cached": 0.0028,
        "context_window": 1000000,
        "default_max_tokens": 384000,
        "can_reason": true,
        "reasoning_levels": [
          "low",
          "high",
          "max"
        ],
        "default_reasoning_effort": "high"
      },
      {
        "id": "deepseek-v4-pro",
        "name": "DeepSeek-V4-Pro",
        "cost_per_1m_in": 0.435,
        "cost_per_1m_out": 0.87,
        "cost_per_1m_in_cached": 0.003625,
        "context_window": 1000000,
        "default_max_tokens": 384000,
        "can_reason": true,
        "reasoning_levels": [
          "low",
          "high",
          "max"
        ],
        "default_reasoning_effort": "high"
      }
    ]
  }
}
