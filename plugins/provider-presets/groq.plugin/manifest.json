{
  "$schema": "../../../provider-preset-plugin.schema.json",
  "plugin_type": "provider-preset",
  "manifest_version": 1,
  "id": "crux.catwalk.groq",
  "version": "0.51.23",
  "name": "Groq Provider Preset",
  "description": "Optional Groq provider and model catalog preset derived from Catwalk v0.51.23 for Crux's Foundation-owned OpenAI-compatible runtime.",
  "publisher": {
    "id": "crux.project",
    "name": "Crux Project",
    "url": "https://github.com/example-git/crux"
  },
  "compatibility": {
    "host_api": {
      "min": 1,
      "max": 1
    }
  },
  "preset": {
    "name": "Groq",
    "id": "groq",
    "type": "openai-compat",
    "api_key": "$GROQ_API_KEY",
    "api_endpoint": "https://api.groq.com/openai/v1",
    "default_large_model_id": "moonshotai/kimi-k2-instruct-0905",
    "default_small_model_id": "qwen/qwen3-32b",
    "models": [
      {
        "id": "moonshotai/kimi-k2-instruct-0905",
        "name": "Kimi K2 0905",
        "cost_per_1m_in": 1,
        "cost_per_1m_out": 3,
        "cost_per_1m_in_cached": 0.5,
        "cost_per_1m_out_cached": 0.5,
        "context_window": 131072,
        "default_max_tokens": 10000,
        "can_reason": true,
        "reasoning_levels": [
          "low",
          "medium",
          "high"
        ],
        "default_reasoning_effort": "medium"
      },
      {
        "id": "qwen/qwen3-32b",
        "name": "Qwen3 32B",
        "cost_per_1m_in": 0.29,
        "cost_per_1m_out": 0.59,
        "context_window": 131072,
        "default_max_tokens": 10000
      }
    ]
  }
}
