{
  "$schema": "../../../provider-preset-plugin.schema.json",
  "plugin_type": "provider-preset",
  "manifest_version": 1,
  "id": "crux.catwalk.alibaba-us",
  "version": "0.51.23",
  "name": "Alibaba (US) Provider Preset",
  "description": "Optional Alibaba (US) provider and model catalog preset derived from Catwalk v0.51.23 for Crux's Foundation-owned OpenAI-compatible runtime.",
  "publisher": {
    "id": "crux.project",
    "name": "Crux Project",
    "url": "https://github.com/example-git/crux"
  },
  "compatibility": {
    "host_api": {
      "min": 1,
      "max": 1
    }
  },
  "preset": {
    "name": "Alibaba (US)",
    "id": "alibaba-us",
    "type": "openai-compat",
    "api_key": "$ALIBABA_US_API_KEY",
    "api_endpoint": "https://dashscope-us.aliyuncs.com/compatible-mode/v1",
    "default_large_model_id": "deepseek-v4-pro-us",
    "default_small_model_id": "deepseek-v4-flash-us",
    "models": [
      {
        "id": "deepseek-v4-pro-us",
        "name": "DeepSeek-V4-Pro",
        "cost_per_1m_in": 2.4,
        "cost_per_1m_out": 4.8,
        "cost_per_1m_in_cached": 0.2,
        "context_window": 1000000,
        "default_max_tokens": 384000,
        "can_reason": true,
        "reasoning_levels": [
          "high",
          "xhigh"
        ],
        "default_reasoning_effort": "high"
      },
      {
        "id": "deepseek-v4-flash-us",
        "name": "DeepSeek-V4-Flash",
        "cost_per_1m_in": 0.2,
        "cost_per_1m_out": 0.4,
        "cost_per_1m_in_cached": 0.04,
        "context_window": 1000000,
        "default_max_tokens": 384000,
        "can_reason": true,
        "reasoning_levels": [
          "high",
          "xhigh"
        ],
        "default_reasoning_effort": "high"
      },
      {
        "id": "qwen3.8-max",
        "name": "Qwen3.8-Max",
        "cost_per_1m_in": 1.65,
        "cost_per_1m_out": 4.951,
        "cost_per_1m_out_cached": 0.206,
        "context_window": 1000000,
        "default_max_tokens": 65536,
        "can_reason": true,
        "supports_attachments": true
      }
    ]
  }
}
