{
  "$schema": "../../../provider-preset-plugin.schema.json",
  "plugin_type": "provider-preset",
  "manifest_version": 1,
  "id": "crux.catwalk.cerebras",
  "version": "0.51.23",
  "name": "Cerebras Provider Preset",
  "description": "Optional Cerebras provider and model catalog preset derived from Catwalk v0.51.23 for Crux's Foundation-owned OpenAI-compatible runtime.",
  "publisher": {
    "id": "crux.project",
    "name": "Crux Project",
    "url": "https://github.com/example-git/crux"
  },
  "compatibility": {
    "host_api": {
      "min": 1,
      "max": 1
    }
  },
  "preset": {
    "name": "Cerebras",
    "id": "cerebras",
    "type": "openai-compat",
    "api_key": "$CEREBRAS_API_KEY",
    "api_endpoint": "https://api.cerebras.ai/v1",
    "default_large_model_id": "gpt-oss-120b",
    "default_small_model_id": "zai-glm-4.7",
    "models": [
      {
        "id": "gpt-oss-120b",
        "name": "OpenAI GPT OSS",
        "cost_per_1m_in": 0.35,
        "cost_per_1m_out": 0.75,
        "context_window": 131072,
        "default_max_tokens": 25000,
        "can_reason": true,
        "reasoning_levels": [
          "low",
          "medium",
          "high"
        ],
        "default_reasoning_effort": "medium"
      },
      {
        "id": "zai-glm-4.7",
        "name": "Z.ai GLM 4.7",
        "cost_per_1m_in": 2.25,
        "cost_per_1m_out": 2.75,
        "context_window": 131072,
        "default_max_tokens": 25000
      }
    ],
    "default_headers": {
      "X-Cerebras-3rd-Party-Integration": "crux"
    }
  }
}
